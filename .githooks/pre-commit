#!/usr/bin/env bash
# Check staged shell content, including partially staged files and spaced paths.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.sh|*.bash|.githooks/pre-commit) files+=("$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#files[@]}" -gt 0 ] || exit 0
command -v shellcheck >/dev/null 2>&1 || {
    echo "ShellCheck missing: run bash scripts/install-shellcheck.sh and add ~/.local/bin to PATH" >&2
    exit 1
}
for file in "${files[@]}"; do
    echo "ShellCheck: $file (staged content)"
    git show ":$file" | shellcheck -
done
