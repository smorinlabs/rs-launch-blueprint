{
  "openapi": "3.1.0",
  "info": {
    "title": "rs-launch-blueprint",
    "description": "Optional HTTP API service for rs-launch-blueprint.",
    "contact": {
      "name": "Steve Morin",
      "email": "steve.morin@gmail.com"
    },
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "ops-healthz",
        "responses": {
          "200": {
            "description": "Process liveness report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessReport"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "ops-readyz",
        "responses": {
          "200": {
            "description": "Service readiness diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Diagnostics"
                }
              }
            }
          },
          "503": {
            "description": "Service draining or readiness check failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "operationId": "projects-list_projects",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of projects per page (default 50, max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque URL-safe base64 pagination cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspace",
            "in": "query",
            "description": "Optional workspace name filter",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated list of projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request or malformed input parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. out-of-range limit)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "operationId": "projects-create_project",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional caller-supplied idempotency key for safe retries",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "description": "Project creation payload",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Bad request or malformed input parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Resource conflict or idempotency key already in flight",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed schema validation or idempotency payload mismatch",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{id}": {
      "get": {
        "tags": [
          "projects"
        ],
        "operationId": "projects-get_project",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Project identifier",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Bad request or malformed input parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "projects"
        ],
        "operationId": "projects-delete_project",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Project identifier",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Project deleted"
          },
          "400": {
            "description": "Bad request or malformed input parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Check": {
        "type": "object",
        "description": "OpenAPI schema representation of core `Check` (`R80`, `R71`).",
        "required": [
          "name",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Redacted human-readable check detail."
          },
          "name": {
            "type": "string",
            "description": "Stable literal check name."
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus",
            "description": "Outcome status (`ok`, `warn`, or `error`)."
          }
        }
      },
      "CheckStatus": {
        "type": "string",
        "description": "OpenAPI schema representation of core `CheckStatus` (`R80`, `R71`).",
        "enum": [
          "ok",
          "warn",
          "error"
        ]
      },
      "CreateProjectInput": {
        "type": "object",
        "description": "OpenAPI schema representation of a core `CreateProjectInput` (`R01`, `R71`).\n\nMirrors [`rs_launch_blueprint_core::CreateProjectInput`] without adding `utoipa` to `crates/core`.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Non-empty human-readable project name.",
            "minLength": 1
          },
          "workspace": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional workspace name."
          }
        }
      },
      "Diagnostics": {
        "type": "object",
        "description": "OpenAPI schema representation of core `Diagnostics` (`R80`, `R71`).",
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "description": "Executed diagnostic checks in stable order."
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "Structured per-field validation entry emitted inside `errors[]` (`R5.15`, `R70`).",
        "required": [
          "pointer",
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable lowercase snake_case machine code describing the rule violated."
          },
          "detail": {
            "type": "string",
            "description": "Sanitized human-readable explanation (never echoing caller values)."
          },
          "pointer": {
            "type": "string",
            "description": "RFC 6901 JSON Pointer locating the offending field or parameter (e.g. `\"/name\"`)."
          }
        }
      },
      "LiveStatus": {
        "type": "string",
        "description": "Static liveness status token emitted by `/healthz` (`R80`).",
        "enum": [
          "ok"
        ]
      },
      "LivenessReport": {
        "type": "object",
        "description": "Exact four-field byte-stable payload emitted by `GET /healthz` (`R80` AC1, AC2).",
        "required": [
          "status",
          "version",
          "os",
          "arch"
        ],
        "properties": {
          "arch": {
            "type": "string",
            "description": "Target CPU architecture (`std::env::consts::ARCH`)."
          },
          "os": {
            "type": "string",
            "description": "Target operating system (`std::env::consts::OS`)."
          },
          "status": {
            "$ref": "#/components/schemas/LiveStatus",
            "description": "Always `\"ok\"`."
          },
          "version": {
            "type": "string",
            "description": "Package SemVer version from `crates/core`."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "OpenAPI schema representation of the RFC 9457 `application/problem+json` error envelope (`R70`, `R71`).",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "catalog_code"
        ],
        "properties": {
          "catalog_code": {
            "type": "string",
            "description": "Stable cross-surface `RSLB###` catalog code (`R67`)."
          },
          "code": {
            "type": "string",
            "description": "Stable lowercase snake_case HTTP error code (`R5.13.1`)."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation specific to this occurrence."
          },
          "diagnostics": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Diagnostics",
                "description": "Optional redacted readiness diagnostics payload emitted by `/readyz` `503` (`R80`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "documentation": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional HTTPS documentation URI (`R5.13.4`)."
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "Optional structured per-field validation errors (`R5.15`)."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request path identifying this occurrence (query string stripped)."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code generated by the origin server for this occurrence.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "Canonical HTTPS problem-type URI (never `about:blank`)."
          }
        }
      },
      "Project": {
        "type": "object",
        "description": "OpenAPI schema representation of a core `Project` (`R01`, `R71`).\n\nMirrors [`rs_launch_blueprint_core::Project`] without adding `utoipa` to `crates/core`.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier assigned by the backing store."
          },
          "name": {
            "type": "string",
            "description": "Human-readable project name."
          },
          "workspace": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional workspace name owning this project."
          }
        }
      },
      "ProjectListResponse": {
        "type": "object",
        "description": "OpenAPI schema representation of cursor-paginated `ListResponse<Project>` (`R72`, `R71`).",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "description": "Page items in deterministic ascending identifier order."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque base64 cursor for the next page, or `null` on the final page."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ops",
      "description": "Operational liveness and readiness probes"
    },
    {
      "name": "projects",
      "description": "Project CRUD and cursor-paginated listing"
    }
  ]
}
