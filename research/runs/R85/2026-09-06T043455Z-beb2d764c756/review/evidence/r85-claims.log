========== 3. anstyle-hyperlink 1.0.2 — the null-object carrier claims ==========

--- 3a. Default renders NOTHING; with_url writes the URL UNMODIFIED ---
impl<D: core::fmt::Display> Default for Hyperlink<D> {
    fn default() -> Self {
        Self { url: None }
    }
}
impl<D: core::fmt::Display> core::fmt::Display for Hyperlink<D> {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        let Some(url) = self.url.as_ref() else {
            return Ok(());
        };
        if f.alternate() {
            write!(f, "\x1B]8;;\x1B\\")
        } else {
            write!(f, "\x1B]8;;{url}\x1B\\")
        }
    }
}
=> open tag = 5 bytes ESC ] 8 ; ; + url + 2 bytes ESC \  (7 + url.len());
   close tag = 7 bytes. No percent-encoding, no control-byte filtering: sanitizing is the caller obligation.

