-- ts @ cb1cbcb2e88b898e8c081b0abbfabc1630079c00 lines 33-39 and 49-52 --
# Trigger set is schedule + workflow_dispatch (per plan), which intentionally
# diverges from the source workflow's literal push/pull_request/workflow_dispatch
# triggers: neither the source file nor contributors-please-action's own
# documented usage example runs on a schedule, but a weekly cadence avoids the
# run-on-every-push noise a push trigger would add on top of the already-heavy
# CI/CodeQL/dependency-review triggers, while workflow_dispatch keeps the
# on-demand escape hatch the source relied on.
on:
  schedule:
    - cron: '17 6 * * 1' # weekly, Monday 06:17 UTC
  workflow_dispatch:

