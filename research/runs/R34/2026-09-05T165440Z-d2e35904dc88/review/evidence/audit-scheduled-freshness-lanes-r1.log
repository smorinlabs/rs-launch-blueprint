   130	  # ADVISORY, NON-GATING Bun dev/test lane (D-036). `continue-on-error: true`
   131	  # means this job can never block a PR or push: Bun tracks Node v23 parity —
   132	  # one major behind this template's engines.node >=24 floor — so it is a
   133	  # forward-compatibility signal, not a required gate. Three hard rules mirror
   134	  # the local `just test-bun` recipe: installs stay pnpm-only (never
   135	  # `bun install`, which would fork a bun.lock and drift from pnpm-lock.yaml);
   136	  # the runner is Vitest driven by `bun run vitest` (never bare `bun test`,
   137	  # which invokes Bun's own runner); tests/e2e.test.ts is excluded because it
   138	  # spawns process.execPath to assert the published Node signal contract
   139	  # (SIGINT->130/SIGTERM->143), which under Bun would exercise Bun's signal
   140	  # emulation instead. The published package + engines are unchanged.
   141	  bun-lane:
   142	    name: bun-lane (advisory, non-gating)
   143	    runs-on: ubuntu-latest
   144	    continue-on-error: true
   145	    permissions:
   146	      # Read-only checkout; nothing here writes.
   147	      contents: read
   148	
   149	    steps:
   150	      - name: Checkout repository
   151	        uses: actions/checkout@v7
   152	        with:
   153	          # No push here; drop the persisted token (zizmor artipacked).
   154	          persist-credentials: false
   155	
   156	      # pnpm on PATH before setup-node so cache:'pnpm' finds the store (D-035).
   157	      - name: Install pnpm
   158	        uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9
   159	        with:
   160	          version: 10.34.3
   161	
   162	      - name: Set up Node.js
   163	        uses: actions/setup-node@v7
   164	        with:
   165	          node-version-file: .nvmrc
   166	          cache: 'pnpm'
   167	
   168	      # Third-party action → full-SHA pin + version comment (D-022(9)).
   169	      - name: Install just
   170	        uses: extractions/setup-just@53165ef7e734c5c07cb06b3c8e7b647c5aa16db3 # v4.0.0
   171	
   172	      # Third-party action → full-SHA pin + version comment (D-022(9)); pinned
   173	      # to the exact Bun release this lane is verified against (D-036).
   174	      - name: Install Bun
   175	        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
   176	        with:
   177	          bun-version: 1.3.14
   178	
   179	      # Installs stay pnpm-only — never `bun install` (would fork a bun.lock).
   180	      - name: Install dependencies
   181	        run: pnpm install --frozen-lockfile
   182	
   183	      - name: Build (Node)
   184	        run: just build
   185	
   186	      # Vitest is the runner (never bare `bun test`); e2e stays Node-only.
   187	      - name: Test under Bun (non-e2e tiers)
   188	        run: bun run vitest run --exclude tests/e2e.test.ts

