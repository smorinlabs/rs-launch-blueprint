{
  "openapi": "3.1.0",
  "info": { "title": "R83 probe", "version": "0.0.0" },
  "paths": {
    "/projects": {
      "post": {
        "operationId": "projects-create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "projects-read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 6 }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProjectCreate": {
        "type": "object",
        "required": ["name", "limit"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 8 },
          "limit": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
