$ sed -n '7,8p;191,202p' base-action/src/install-plugins.ts
const MARKETPLACE_URL_REGEX =
  /^https:\/\/[a-zA-Z0-9\-._~:/?#[\]@!$&'()*+,;=%]+\.git$/;
async function addMarketplace(
  claudeExecutable: string,
  marketplace: string,
): Promise<void> {
  console.log(`Adding marketplace: ${marketplace}`);

  return executeClaudeCommand(
    claudeExecutable,
    ["plugin", "marketplace", "add", marketplace],
    `Failed to add marketplace '${marketplace}'`,
  );
}

# Reading: the regex anchors the END of the string to '.git', so no ref, tag, commit,
# '#fragment' or trailing path can be expressed — a marketplace URL is structurally unpinnable.

