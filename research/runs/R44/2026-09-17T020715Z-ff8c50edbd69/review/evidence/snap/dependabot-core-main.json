l":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ecffe98c0fd8a8fa9810ce34690b10e060f8af9f","url":"https://api.github.com/repos/dependabot/dependabot-core/commits/ecffe98c0fd8a8fa9810ce34690b10e060f8af9f","html_url":"https://github.com/dependabot/dependabot-core/commit/ecffe98c0fd8a8fa9810ce34690b10e060f8af9f"}],"stats":{"total":29,"additions":28,"deletions":1},"files":[{"sha":"93323fce7da6897d8bf119d19f5875f8b68e4e3b","filename":"docker/README.md","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/dependabot/dependabot-core/blob/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2FREADME.md","raw_url":"https://github.com/dependabot/dependabot-core/raw/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2FREADME.md","contents_url":"https://api.github.com/repos/dependabot/dependabot-core/contents/docker%2FREADME.md?ref=dc25739e082c6d97399b476ad4eb06b5559895e7","patch":"@@ -22,6 +22,8 @@ Docker support for [`dependabot-core`][core-repo].\n ### Supported tag schemas\n \n Dependabot supports updates for Docker tags that use semver versioning, dates, and build numbers.\n+In Helm values files, image tags containing template expressions (for example,\n+`tag: \"{{ .Values.image.tag }}\"`) are skipped because Dependabot does not render charts and cannot resolve their values.\n The Docker tag class is located at:\n https://github.com/dependabot/dependabot-core/blob/main/docker/lib/dependabot/docker/tag.rb\n "},{"sha":"2c7d301dd170c34b5e641157de8e0317bc5d29ee","filename":"docker/lib/dependabot/docker/file_parser.rb","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/dependabot/dependabot-core/blob/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2Flib%2Fdependabot%2Fdocker%2Ffile_parser.rb","raw_url":"https://github.com/dependabot/dependabot-core/raw/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2Flib%2Fdependabot%2Fdocker%2Ffile_parser.rb","contents_url":"https://api.github.com/repos/dependabot/dependabot-core/contents/docker%2Flib%2Fdependabot%2Fdocker%2Ffile_parser.rb?ref=dc25739e082c6d97399b476ad4eb06b5559895e7","patch":"@@ -145,7 +145,11 @@ def parse_helm(img_hash)\n         repo = img_hash.fetch(\"repository\", nil)\n         return [] unless repo.is_a?(String)\n \n-        match = tag_value.to_s.match(TAG_WITH_DIGEST)\n+        tag = tag_value.to_s\n+        # Helm template expressions cannot be resolved without rendering the chart.\n+        return [] if tag.include?(\"{{\")\n+\n+        match = tag.match(TAG_WITH_DIGEST)\n         return [] unless match\n \n         tag_details = match.named_captures"},{"sha":"3399baf29739c22c6ed90d837078b5a1c202ccef","filename":"docker/spec/dependabot/docker/file_parser_spec.rb","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/dependabot/dependabot-core/blob/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2Fspec%2Fdependabot%2Fdocker%2Ffile_parser_spec.rb","raw_url":"https://github.com/dependabot/dependabot-core/raw/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2Fspec%2Fdependabot%2Fdocker%2Ffile_parser_spec.rb","contents_url":"https://api.github.com/repos/dependabot/dependabot-core/contents/docker%2Fspec%2Fdependabot%2Fdocker%2Ffile_parser_spec.rb?ref=dc25739e082c6d97399b476ad4eb06b5559895e7","patch":"@@ -1340,6 +1340,16 @@\n       its(:length) { is_expected.to eq(0) }\n     end\n \n+    context \"with templated tags\" do\n+      let(:helmfile_fixture_name) { \"templated-tags.yaml\" }\n+\n+      it \"ignores tags that require Helm template rendering\" do\n+        expect(dependencies.map { |dependency| [dependency.name, dependency.version] }).to eq(\n+          [[\"busybox\", \"1.36.1\"]]\n+        )\n+      end\n+    end\n+\n     context \"with no registry\" do\n       let(:helmfile_fixture_name) { \"no-registry.yaml\" }\n "},{"sha":"397c878bb046dd118fdde424eac7605de39d0b56","filename":"docker/spec/fixtures/helm/yaml/templated-tags.yaml","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/dependabot/dependabot-core/blob/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2Fspec%2Ffixtures%2Fhelm%2Fyaml%2Ftemplated-tags.yaml","raw_url":"https://github.com/dependabot/dependabot-core/raw/dc25739e082c6d97399b476ad4eb06b5559895e7/docker%2Fspec%2Ffixtures%2Fhelm%2Fyaml%2Ftemplated-tags.yaml","contents_url":"https://api.github.com/repos/dependabot/dependabot-core/contents/docker%2Fspec%2Ffixtures%2Fhelm%2Fyaml%2Ftemplated-tags.yaml?ref=dc25739e082c6d97399b476ad4eb06b5559895e7","patch":"@@ -0,0 +1,11 @@\n+image:\n+  repository: nginx\n+  tag: \"{{ .Values.image.tag }}\"\n+prefixed:\n+  image:\n+    repository: alpine\n+    tag: \"release-{{ .Values.image.tag }}\"\n+static:\n+  image:\n+    repository: busybox\n+    tag: \"1.36.1\""}]}