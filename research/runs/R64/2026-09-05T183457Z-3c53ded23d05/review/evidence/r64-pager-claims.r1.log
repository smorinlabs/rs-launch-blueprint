    63	def _pager_argv(pager: str) -> list[str]:
    64	    """Tokenize the pager command per-platform.
    65	
    66	    POSIX shlex rules eat backslashes, mangling Windows paths like
    67	    ``C:\\tools\\less.exe``. On Windows, split with ``posix=False`` (which
    68	    preserves backslashes) and strip the surrounding quotes that mode keeps.
    69	    Quoting is the supported spelling for a path with spaces; an unquoted
    70	    one still tokenizes wrong, fails to launch, and falls back to plain
    71	    output via the caller's error handling.
    72	    """
    73	    if not _WINDOWS:
    74	        return shlex.split(pager)
    75	    argv = shlex.split(pager, posix=False)
    76	    return [
    77	        arg[1:-1] if len(arg) >= 2 and arg[0] == arg[-1] and arg[0] in "'\"" else arg
    78	        for arg in argv
    79	    ]
    80	
    81	
    82	def _resolve_pager_command() -> str:
    83	    """Pager precedence: ``PLBP_PAGER`` > ``PAGER`` > ``less -FRX``.
    84	
    85	    A variable that is set but empty *disables* paging (git convention) —
    86	    only an unset variable falls through to the next layer.
    87	    """
    88	    for var in ("PLBP_PAGER", "PAGER"):
    89	        if var in os.environ:
    90	            return os.environ[var].strip()
    91	    return DEFAULT_PAGER
    92	
    93	
    94	def _isatty(console: Console) -> bool:
    95	    """True when the console's underlying stream is a real TTY.
    96	
    97	    ``Console.is_terminal`` is forced True by ``color="always"`` — right for
    98	    styling, wrong for paging: a piped run must never block on a pager, no
    99	    matter how color was resolved.
   100	    """
   101	    isatty = getattr(console.file, "isatty", None)
   102	    if isatty is None:
   103	        return False
   104	    try:
   105	        return bool(isatty())
   106	    except ValueError:  # closed/replaced stream
   107	        return False
