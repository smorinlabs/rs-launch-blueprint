[package]
name = "r58probe"
version = "0.0.0"
edition = "2024"
rust-version = "1.96"
publish = false

[dependencies]
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["env-filter", "json"] }
log = "0.4"
tracing-log = "0.2"
secrecy = "0.10.3"
serde_json = "1"

[[bin]]
name = "r58probe"
path = "src/main.rs"

[workspace]
