=== S7. casey/just's 'cargo lclippy' is not an alias: it is cargo-limit, a crates.io plugin its own justfile installs ===
  cargo install -f just

# install development dependencies
[group: 'dev']
install-dev-deps:
  rustup install nightly
  rustup update nightly
  cargo install cargo-limit
  cargo install cargo-watch
  cargo install --locked mdbook@0.4.52
  cargo install --locked mdbook-linkcheck@0.7.7

# everyone's favorite animate paper clip
[group: 'check']
clippy: (watch 'lclippy --all --all-targets --all-features -- --deny warnings')

