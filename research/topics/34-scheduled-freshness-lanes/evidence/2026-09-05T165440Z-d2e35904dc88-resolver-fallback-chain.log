     1	# WL-012 - scheduled "canary" run: the FULL suite (incl. the slow/live markers
     2	# the per-PR run also exercises) against a FRESHLY-RESOLVED dependency graph.
     3	#
     4	# Why separate from ci.yml: every other job pins to uv.lock (WL-002) so PRs are
     5	# reproducible. This one deliberately drops the lock and re-resolves to the
     6	# newest allowed versions (`uv sync --upgrade`), so an upstream breaking change
     7	# in a transitive dep (a new pydantic/click/requests release) surfaces in a
     8	# calm scheduled run we can triage — not inside an unrelated feature PR weeks
     9	# later. It NEVER gates a PR (schedule + manual dispatch only), so a red canary
    10	# is a signal, not a blocker.
    11	
    12	name: canary
    13	
    14	on:
    15	  schedule:
    16	    - cron: '0 6 * * 2'  # weekly, Tuesday 06:00 UTC (offset from dep-audit's Monday)
    17	  workflow_dispatch:
    18	
    19	permissions: {}
    20	
    21	concurrency:
    22	  group: canary
    23	  cancel-in-progress: true
    24	
    25	jobs:
    26	  canary:
    27	    name: canary (py${{ matrix.python-version }}, latest deps)
    28	    runs-on: ${{ vars.RUNNER_UBUNTU || 'ubuntu-latest' }}
    29	    permissions:
    30	      contents: read
    31	    strategy:
    32	      fail-fast: false  # report both Python legs even if one breaks
    33	      matrix:
    34	        python-version: ["3.12", "3.13"]
    35	    steps:
    36	      - uses: actions/checkout@v7
    37	
    38	      - name: Install uv
    39	        uses: astral-sh/setup-uv@v8.3.2
    40	        with:
    41	          python-version: ${{ matrix.python-version }}
    42	
    43	      - name: Re-resolve to the latest allowed dependency versions
    44	        # --upgrade ignores the committed uv.lock pins and picks the newest
    45	        # versions satisfying pyproject constraints. This is the whole point of
    46	        # the canary; do NOT add --locked here.
    47	        run: uv sync --upgrade --group dev --extra web
    48	
    49	      - name: Run the full suite (incl. slow + live markers)
    50	        # `-m ""` clears the default slow/live exclusion; `-n auto` parallelises.
    51	        # No coverage upload — the canary is about dependency health, not %.
    52	        run: uv run --no-sync pytest -m "" -n auto

