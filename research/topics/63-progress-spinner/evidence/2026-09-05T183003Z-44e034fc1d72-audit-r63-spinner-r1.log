        31	export const realSpinner: SpinnerFactory = (text) => {
        32	  // Flood guard (D-033): yocto-spinner's line-clear loop divides the
        33	  // rendered length by the stream width, so a TTY reporting 0 columns
        34	  // (some pseudo-terminals/serial consoles) makes Math.ceil(len/0) =
        35	  // Infinity and floods stderr with clear sequences. Treat a width-less
        36	  // or nonsensical width as non-TTY and skip the spinner entirely.
        37	  const columns = process.stderr.columns;
        38	  if (!Number.isFinite(columns) || columns <= 0) {
        39	    return { stop: () => undefined };
        40	  }
